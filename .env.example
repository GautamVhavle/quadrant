# OpenRouter powers the four question triage.
# Copy this file to .env.local and fill in a real key. Without a key the app
# falls back to the deterministic mapping and says so in the interface.
OPENROUTER_API_KEY=sk-or-v1-DUMMY-REPLACE-ME

# Any OpenRouter model id. A small fast model is enough for a four answer task.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional overrides for the rate limiter, requests per window and window length in seconds.
TRIAGE_REQUESTS_PER_WINDOW=12
TRIAGE_WINDOW_SECONDS=600
